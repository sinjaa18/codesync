{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "npm run db:generate && tsc",
    "test": "npm run db:generate && npm run test:db:reset && npm run test:typecheck && npm run test:unit && npm run test:integration:run",
    "test:unit": "node --import tsx --test test/unit/execution.test.ts test/unit/test-database-guard.test.ts",
    "test:integration": "npm run db:generate && npm run test:db:reset && npm run test:integration:run",
    "test:integration:run": "node --env-file-if-exists=.env.test.local --import tsx --test test/integration/collaboration.test.ts",
    "test:db:reset": "node --env-file-if-exists=.env.test.local scripts/reset-test-db.mjs",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.19.0",
    "yjs": "^13.6.33",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "prisma": "^6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
